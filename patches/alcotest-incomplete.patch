           (pp_result_full ~max_label ~doc_of_test_name ~selector_on_failure)
-          (tname, r)
+          (tname, r);
+        (match r with
+         | `Incomplete msg -> (
+             match String.cuts ~sep:"\n" msg with
+             | _ :: (_ :: _ as rest) ->
