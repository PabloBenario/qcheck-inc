From dbccac97fe8a9219a1529dc4e6691b47498d03eb Mon Sep 17 00:00:00 2001
From: PabloBenario <pablo.benario@ug.uchile.cl>
Date: Fri, 24 Apr 2026 10:57:38 -0400
Subject: [PATCH 7/9] Add per-test verdict suffix hook

Expose Pp.current_test_suffix (a string option ref) and
Alcotest.set_test_suffix so that a test runner can attach a short
annotation to the current test's verdict line.

The renderer reads and clears the ref once per test verdict,
appending the suffix after the test description (3-space gap), and
reserves the suffix width when computing available_width so the
description truncates earlier if needed.

When set_test_suffix is never called the ref stays None and the
suffix branch is skipped; upstream behaviour is unchanged.
---
 src/alcotest-engine/pp.ml      | 15 ++++++++++++---
 src/alcotest-engine/pp_intf.ml |  5 +++++
 src/alcotest-engine/test.ml    |  1 +
 src/alcotest-engine/test.mli   |  9 +++++++++
 4 files changed, 27 insertions(+), 3 deletions(-)

diff --git a/src/alcotest-engine/pp.ml b/src/alcotest-engine/pp.ml
index c3ffa2f..e1b63cd 100644
--- a/src/alcotest-engine/pp.ml
+++ b/src/alcotest-engine/pp.ml
@@ -44,6 +44,11 @@ let pp_tag ~wrapped ppf typ =
 
 let tag = pp_tag ~wrapped:false
 
+(* Suffix to append to the current test's verdict line. Set via
+   [Alcotest.set_test_suffix] before the test closure returns/raises;
+   read and cleared when the verdict is rendered. *)
+let current_test_suffix : string option ref = ref None
+
 module Make (P : sig
   val stdout_columns : unit -> int option
 end) =
@@ -130,13 +135,14 @@ struct
      else const char ' ')
     ++ const char ' '
 
-  let pp_result_full ~max_label ~doc_of_test_name ~selector_on_failure ppf
-      (path, result) =
+  let pp_result_full ~max_label ~doc_of_test_name ~selector_on_failure
+      ~suffix ppf (path, result) =
     let with_selector = selector_on_failure && Run_result.is_failure result in
     (left_padding ~with_selector) ppf ();
     pp_result ppf result;
     let available_width = Lazy.force terminal_width - left_total in
     (info ~available_width ~max_label ~doc_of_test_name) ppf path;
+    (match suffix with Some s -> Fmt.pf ppf "   %s" s | None -> ());
     ()
 
   let event_line ~margins ~max_label ~doc_of_test_name ppf = function
@@ -169,9 +175,12 @@ struct
           Format.pp_force_newline ppf ();
         ()
     | false, _, `Result (tname, r) ->
+        let suffix = !current_test_suffix in
+        current_test_suffix := None;
